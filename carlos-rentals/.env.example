# Copy to .env and fill in what you have. Everything is optional: with nothing set the
# system runs in demo mode (sample leads, sandbox sends) so you can try it safely.

# --- Business (shown on the website and used in messages) ---
CARLOS_BUSINESS_NAME=CAR-LOS Rentals
CARLOS_PHONE=
CARLOS_EMAIL=
CARLOS_ADDRESS=
CARLOS_CITY=
CARLOS_TIMEZONE=America/New_York
# The public address of the website (used in links the agents send). No trailing slash.
CARLOS_SITE_URL=http://localhost:8080

# --- Console login (generated on first run if empty) ---
CARLOS_OPS_PASSWORD=
CARLOS_SECRET_KEY=
# Set to true when the console is served over HTTPS
CARLOS_HTTPS_COOKIES=false

# --- Claude (better replies + bookings inside chats). Without it, agents use rules. ---
ANTHROPIC_API_KEY=
CARLOS_MODEL=claude-opus-5-5

# --- Meta: Facebook Page + Instagram professional account (see docs/CONNECT.md) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=

# --- Threads ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Email (booking confirmations, reminders, owner alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_EMAIL=

# --- Storage ---
CARLOS_DB=data/carlos.db
CARLOS_UPLOAD_DIR=data/uploads
