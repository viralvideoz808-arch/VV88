# Copy to .env. Only fill in what you use.

# Discovery
APIFY_TOKEN=                 # Whop Content Rewards listings (Apify free tier is enough)
YOUTUBE_API_KEY=             # niche traffic signal (free YouTube Data API key)

# Optional Claude re-ranking (llm.enabled: true)
ANTHROPIC_API_KEY=

# Publishing via Postiz (recommended: one integration for all four platforms)
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=

# Publishing via official APIs (publishing.backend: direct); also used to read view counts
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=       # scope: https://www.googleapis.com/auth/youtube.upload (+ youtube.readonly for stats)

INSTAGRAM_USER_ID=           # Instagram professional account id
INSTAGRAM_ACCESS_TOKEN=      # Facebook Login for Business token: instagram_content_publish, instagram_manage_insights

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=         # scopes: video.publish (+ video.list for stats)
TIKTOK_REFRESH_TOKEN=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=              # OAuth 2.0 user token: tweet.write, media.write, users.read, offline.access
X_REFRESH_TOKEN=
