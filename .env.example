# Copy to .env. Only fill in what you use.

# Discovery
APIFY_TOKEN=                 # Whop Content Rewards listings (Apify free tier is enough)
YOUTUBE_API_KEY=             # niche traffic signal (free YouTube Data API key)

# Optional Claude re-ranking (llm.enabled: true)
ANTHROPIC_API_KEY=

# Publishing via Postiz (recommended: one integration for all four platforms)
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
# filled in by `vv88 connect postiz`:
POSTIZ_INTEGRATION_TIKTOK=
POSTIZ_INTEGRATION_YOUTUBE=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_X=

# Publishing via official APIs (publishing.backend: direct); also used to read view counts
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=       # filled in by `vv88 connect youtube`

FACEBOOK_APP_ID=             # Meta app with Facebook Login for Business (for `vv88 connect instagram`)
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=        # optional https redirect (then: vv88 connect instagram --paste)
FACEBOOK_LOGIN_CONFIG_ID=     # optional Facebook Login for Business configuration id
INSTAGRAM_USER_ID=           # filled in by `vv88 connect instagram`
INSTAGRAM_ACCESS_TOKEN=      # filled in by `vv88 connect instagram` (~60-day token)

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=         # filled in by `vv88 connect tiktok`
TIKTOK_REFRESH_TOKEN=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=              # filled in by `vv88 connect x`
X_REFRESH_TOKEN=
